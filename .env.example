# ---- Application ----
NODE_ENV=development
APP_URL=http://localhost:3000
# 32 bytes, base64. Generate with: openssl rand -base64 32
# Used to encrypt integration credentials at rest (AES-256-GCM). Never commit the real value.
APP_ENCRYPTION_KEY=
# Secret for auth sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm
# Used by `npm test` (a separate database that is wiped between runs)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm_test

# ---- Microsoft 365 / Entra ID single sign-on (optional) ----
# Leave blank to use email + password only.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ---- Integrations ----
# All integration credentials are entered in the app (Settings -> Integrations) and stored encrypted.
# These env vars are only for the OAuth app registrations themselves.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Xero webhook signing key from the developer portal
XERO_WEBHOOK_KEY=

# NinjaOne: create an "API Services (machine-to-machine)" client with the `monitoring` scope only.
NINJAONE_REGION=eu
NINJAONE_CLIENT_ID=
NINJAONE_CLIENT_SECRET=

# Better Proposals: API token from Settings -> Integrations -> API (Premium / Enterprise plans only)
BETTER_PROPOSALS_API_TOKEN=

# ---- Demo mode ----
# When an integration has no credentials, the app can use a clearly labelled demo adapter
# with synthetic data. Never enable in production.
DEMO_MODE=false

# ---- Logging ----
LOG_LEVEL=info
