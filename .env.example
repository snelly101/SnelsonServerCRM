# ---- Application ----
NODE_ENV=development
APP_URL=http://localhost:3000
# 32 bytes, base64. Generate with: openssl rand -base64 32
# Used to encrypt integration credentials at rest (AES-256-GCM). Never commit the real value.
APP_ENCRYPTION_KEY=
# Secret for auth sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Sign-in attempts allowed per IP per minute (default 10). Raise only for automated browser tests.
# AUTH_SIGN_IN_MAX_PER_MINUTE=10

# ---- Database ----
# Local development / shared hosting: a full connection string.
# Docker Compose (docs/deployment.md): leave DATABASE_URL blank and set POSTGRES_PASSWORD instead;
# compose builds the URL for the internal db container.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm
POSTGRES_PASSWORD=
# Used by `npm test` (a separate database that is wiped between runs)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm_test

# ---- Microsoft 365 / Entra ID single sign-on (optional) ----
# Leave blank to use email + password only.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ---- Production (Docker Compose) ----
# Public hostname; Caddy obtains the TLS certificate for it.
CRM_DOMAIN=
# Encrypts nightly database dumps (deploy/backup.sh). Optional off-site copy: BACKUP_S3_BUCKET + AWS_* credentials.
BACKUP_PASSPHRASE=

# ---- Integrations ----
# Better Proposals and NinjaOne credentials are entered in the app (Integrations page) and stored encrypted.
# Xero validates the redirect URI against its app registration, so the app's own id/secret live here.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Xero webhook signing key from the developer portal
XERO_WEBHOOK_KEY=

# ---- Demo mode ----
# When an integration has no credentials, the app can use a clearly labelled demo adapter
# with synthetic data. Never enable in production.
DEMO_MODE=false

# ---- Logging ----
LOG_LEVEL=info
